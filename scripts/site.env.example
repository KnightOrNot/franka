# Copy to config/site.env and fill in your site values. Empty values use CLI defaults.
# Use an absolute data path on your capture disk and an absolute, owner-private
# socket path shared with the existing telemetry bridge. Keep the real file local.
export FRANKA_CAPTURE_SOCKET=
FRANKA_CAPTURE_CAMERA_SERIAL=
FRANKA_CAPTURE_WIDTH=640
FRANKA_CAPTURE_HEIGHT=480
FRANKA_CAPTURE_FPS=30
FRANKA_CAPTURE_DATA_ROOT=
FRANKA_CAPTURE_DATASET_ROOT=
FRANKA_CAPTURE_HTTP_PORT=8078
FRANKA_CAPTURE_CONTROL_REVISION=
FRANKA_CAPTURE_STALE_MS=350
FRANKA_CAPTURE_MAX_SKEW_MS=35
FRANKA_CAPTURE_MIN_FREE_MB=1024
FRANKA_CAPTURE_MAX_SECONDS=300
